{
  "name": "knotzharddrivin",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Hard Drivin': Pacific Run — a coastal driving game built with Three.js and Rapier.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/optimize-assets.mjs dist",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "benchmark:performance": "node scripts/benchmark-performance.mjs",
    "verify:performance-build": "node scripts/verify-performance-build.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.1",
    "howler": "^2.2.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/howler": "^2.2.12",
    "@types/three": "^0.180.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KnotEnvy/KnotzHardDrivin.git"
  },
  "bugs": {
    "url": "https://github.com/KnotEnvy/KnotzHardDrivin/issues"
  },
  "homepage": "https://github.com/KnotEnvy/KnotzHardDrivin#readme",
  "license": "ISC"
}
