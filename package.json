{
  "name": "knotzharddrivin",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Hard Drivin' — a browser & mobile 3D stunt-driving game (clean-slate rewrite).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
